# Copy this file to .env and fill in what you have. Only GEMINI_API_KEY matters for the AI features.

# Free key from https://aistudio.google.com/apikey  (needed for results extraction, summaries, research)
GEMINI_API_KEY=

# Optional: override model names if Google renames them
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# GEMINI_SMART_MODEL=gemini-flash-latest

# Optional fallback for text-only tasks (free key from https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: sharp company logos (free key from https://www.logo.dev, use the PUBLISHABLE key that starts with pk_)
LOGO_DEV_TOKEN=

# Your first name for the greeting ("Good evening, ...")
FINN_USER_NAME=

# Local: leave empty to use SQLite in backend/data/finn.db
# Deployed: a Postgres URL, e.g. from neon.tech
DATABASE_URL=

# Set to 1 ONLY to see the UI with clearly-labelled synthetic data (separate database)
FINN_SAMPLE_MODE=0

# Background refresh inside the server (every 30 min)
FINN_RUN_SCHEDULER=1
FINN_ANNOUNCEMENT_POLL_MINUTES=30

# Deployment: allow only your frontend, and protect the cron refresh endpoint
FINN_CORS_ORIGINS=*
FINN_REFRESH_SECRET=
